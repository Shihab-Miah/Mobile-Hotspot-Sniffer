    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self._ready = False
        self._busy = False
        self._capturing = False
        self._thread = None
        self._stop = threading.Event()
        self._lock = threading.RLock()
        self._ui_lock = threading.Lock()
        self._last_ui_refresh = 0.0

        # Navigation & Selection
        self._page = "live"  # live (terminal), packets (table), detail, stats, pcap, settings
        self._selected_pkt_idx = None
        self._filter_proto = "ALL"  # ALL, HOTSPOT, DNS, TLS, TCP, UDP, ICMP
        self._filter_query = ""
        self._auto_scroll = True

        # Capture Configuration
        self._iface = self.DEFAULT_IFACE
        self._promisc = True
        self._auto_save_pcap = False
        self._ring_limit = 1500

        # Packet Storage
        self._packets = deque(maxlen=self._ring_limit)
        self._pkt_counter = 0
        self._bytes_total = 0
        self._start_time = 0.0
        self._capture_rate = 0.0

        # Connected Hotspot Devices Registry & Nameplate Data
        self._connected_devices = {}  # {ip: {"ip", "mac", "name", "vendor", "category", "icon", "pkts", "bytes", "domains", "last_seen", "state"}}
        self._last_poll_clients = 0.0
        self._hotspot_clients = set()
        self._client_traffic = {}

        # Stats
        self._top_talkers = Counter()
        self._proto_counts = Counter()
        self._hotspot_domains = Counter()

        # Shell environment
        self._shell_mode = "none"  # shizuku, root, none
        self._uid = ""

        # PCAP browser
        self._folder = "/sdcard/Download"

    # ═══════════ LIFECYCLE ═══════════

    def on_plugin_load(self):
        try:
            self.add_module(
                title="PacketShark",
                description="Wireshark Packet Sniffer & Hotspot Analyzer",
                icon="rounded:wifi_tethering",
                screen="main",
                section="PLUGINS",
                order=0
            )
        except Exception as exc:
            self._log("error", "add_module failed: " + str(exc))

        self._detect_shell()
        self._load_state()
        self._detect_active_hotspot()
        self._poll_system_clients()
        self._ready = True
        self._log("info", "PacketShark ready · Shell: {} · Interface: {}".format(
            self._shell_mode.upper(), self._iface))

    def on_load(self):
        self.on_plugin_load()

    def on_unload(self):
        self._stop_capture()
        self._ready = False

    def on_plugin_unload(self):
        self.on_unload()

    def _detect_active_hotspot(self):
        # Auto-detect if ap0 or hotspot is active
        try:
            with open("/proc/net/dev", "r") as f:
                content = f.read()
                if "ap0:" in content:
                    self._iface = "ap0"
                elif "wlan1:" in content:
                    self._iface = "wlan1"
        except Exception:
            pass

    def _lookup_oui(self, mac):
        if not mac or len(mac) < 8:
            return "Unknown Vendor"
        prefix = mac.lower()[:8]
        return self.OUI_DATABASE.get(prefix, "Unknown Vendor")

    def _categorize_device(self, name, vendor, mac, vendor_class="", ttl=None):
        blob = (name + " " + vendor + " " + vendor_class).lower().replace("-", " ").replace("_", " ")

        # 1. Smart TV / Streaming
        if any(k in blob for k in ("tv", "roku", "bravia", "firetv", "chromecast", "appletv", "tizen", "webos")):
            return "Smart TV / Streaming", "tv"

        # 2. Tablet
        if any(k in blob for k in ("ipad", "galaxy tab", "tab a", "tab s", "surface pro", "lenovo tab", "tablet")):
            return "Tablet", "tablet_android"

        # 3. Mobile Phone
        if any(k in blob for k in ("iphone", "galaxy s", "galaxy a", "galaxy z", "pixel", "redmi", "xiaomi",
                                   "oneplus", "oppo", "vivo", "realme", "motorola", "huawei phone")):
            return "Mobile Phone", "phone_android"
        if "android" in blob and not any(k in blob for k in ("tv", "pc", "laptop", "tablet", "tab")):
            return "Mobile Phone", "phone_android"

        # 4. Laptop / PC / Desktop
        if any(k in blob for k in ("laptop", "desktop", "pc", "macbook", "thinkpad", "surface",
                                   "dell", "hp", "lenovo", "intel", "asus", "acer", "msi",
                                   "msft 5.0", "windows", "ubuntu", "fedora", "arch", "workstation")):
            return "Laptop / PC", "laptop_mac"

        # 5. Smart Home / IoT
        if any(k in blob for k in ("raspberry", "espressif", "esp32", "esp8266", "printer", "camera")):
            return "IoT / Smart Device", "memory"

        # TTL heuristic: Windows defaults to TTL=128
        if ttl and 64 < ttl <= 128:
            return "Laptop / PC (Windows)", "laptop_mac"

        return "Connected Device", "devices"

    def _register_or_update_device(self, ip, mac="", name="", vendor_class="", ttl=None):
        if not ip or ip.endswith(".255") or ip in ("0.0.0.0", "255.255.255.255"):
            return
        # Skip gateway if it's our own IP (.1) unless explicit name given
        if ip.endswith(".1") and not name:
            return

        with self._lock:
            dev = self._connected_devices.get(ip)
            if not dev:
                dev = {
                    "ip": ip,
                    "mac": mac or "Unknown",
                    "name": name or "",
                    "vendor": self._lookup_oui(mac) if mac else "Unknown Vendor",
                    "category": "Client",
                    "icon": "devices",
                    "pkts": 0,
                    "bytes": 0,
                    "domains": set(),
                    "last_seen": time.time(),
                    "state": "Connected"
                }
                self._connected_devices[ip] = dev
            else:
                if mac and (dev["mac"] == "Unknown" or not dev["mac"]):
                    dev["mac"] = mac
                    dev["vendor"] = self._lookup_oui(mac)
                if name and not dev["name"]:
                    dev["name"] = name
                dev["last_seen"] = time.time()

            # If device name still empty, generate a readable identifier
            if not dev["name"]:
                if dev["vendor"] != "Unknown Vendor":
                    dev["name"] = "{} Device".format(dev["vendor"].split()[0])
                else:
                    dev["name"] = "Device-" + ip.split(".")[-1]

            # Categorize device
            cat, icon = self._categorize_device(dev["name"], dev["vendor"], dev["mac"], vendor_class, ttl)
            dev["category"] = cat
            dev["icon"] = icon

            self._hotspot_clients.add(ip)

    def _poll_system_clients(self):
        # 1. Check ARP / ip neigh table
        try:
            raw_neigh = ""
            if self._shell_mode == "root" and hasattr(self, "root"):
                raw_neigh = self.root("ip neigh")
            elif self._shell_mode == "shizuku" and hasattr(self, "shizuku"):
                raw_neigh = self.shizuku("ip neigh")
            else:
                try:
                    res = subprocess.run(["ip", "neigh"], stdout=subprocess.PIPE, text=True, timeout=1.0)
                    raw_neigh = res.stdout
                except Exception:
                    pass

            if not raw_neigh:
                try:
                    if self._shell_mode == "root" and hasattr(self, "root"):
                        raw_neigh = self.root("cat /proc/net/arp")
                    elif self._shell_mode == "shizuku" and hasattr(self, "shizuku"):
                        raw_neigh = self.shizuku("cat /proc/net/arp")
                except Exception:
                    pass

            text_neigh = self._text(raw_neigh)
            for line in text_neigh.splitlines():
                parts = line.strip().split()
                # ip neigh: 192.168.43.152 dev ap0 lladdr 38:f9:d3:4a:12:ef REACHABLE
                if len(parts) >= 5 and parts[1] == "dev" and parts[3] == "lladdr":
                    ip = parts[0]
                    mac = parts[4].lower()
                    if ":" in mac and len(mac) == 17:
                        self._register_or_update_device(ip, mac=mac)
                # /proc/net/arp: 192.168.43.152 0x1 0x2 38:f9:d3:4a:12:ef * ap0
                elif len(parts) >= 4 and ":" in parts[3]:
                    ip = parts[0]
                    mac = parts[3].lower()
                    if len(mac) == 17 and mac != "00:00:00:00:00:00":
                        self._register_or_update_device(ip, mac=mac)
        except Exception as exc:
            self._log("warning", "poll neigh: " + str(exc)[:80])

        # 2. Check dnsmasq.leases for real hostnames assigned by Android hotspot daemon
        try:
            leases_paths = [
                "/data/misc/wifi/dnsmasq.leases",
                "/data/vendor/wifi/dnsmasq.leases",
                "/data/misc/dhcp/dnsmasq.leases",
            ]
            for lp in leases_paths:
                raw_leases = ""
                if self._shell_mode == "root" and hasattr(self, "root"):
                    raw_leases = self.root("cat " + lp)
                elif self._shell_mode == "shizuku" and hasattr(self, "shizuku"):
                    raw_leases = self.shizuku("cat " + lp)
                text_leases = self._text(raw_leases)
                if text_leases and "No such file" not in text_leases:
                    for line in text_leases.splitlines():
                        parts = line.strip().split()
                        # <time> <mac> <ip> <hostname> <client_id>
                        if len(parts) >= 4:
                            mac = parts[1].lower()
                            ip = parts[2]
                            hostname = parts[3]
                            if hostname == "*":
                                hostname = ""
                            self._register_or_update_device(ip, mac=mac, name=hostname)
        except Exception as exc:
            self._log("warning", "poll leases: " + str(exc)[:80])

    def _parse_dhcp(self, payload):
        if len(payload) < 240:
            return None
        if payload[236:240] != b"\x63\x82\x53\x63":
            return None
        client_mac = self._mac_to_str(payload[28:34])
        hostname = ""
        vendor_class = ""
        msg_type = ""
        idx = 240
        while idx < len(payload):
            opt = payload[idx]
            if opt == 255:
                break
            if opt == 0:
                idx += 1
                continue
            if idx + 1 >= len(payload):
                break
            olen = payload[idx + 1]
            oval = payload[idx + 2:idx + 2 + olen]
            if opt == 12:
                hostname = oval.decode("utf-8", errors="replace").strip()
            elif opt == 60:
                vendor_class = oval.decode("utf-8", errors="replace").strip()
            elif opt == 53 and olen >= 1:
                mtypes = {1: "Discover", 2: "Offer", 3: "Request", 4: "Decline", 5: "ACK", 6: "NAK", 7: "Release"}
                msg_type = mtypes.get(oval[0], str(oval[0]))
            idx += 2 + olen
        return {"mac": client_mac, "hostname": hostname, "vendor_class": vendor_class, "msg_type": msg_type}

    def _parse_nbns_name(self, payload):
        if len(payload) < 46:
            return None
        try:
            name_len = payload[12]
            if name_len != 32:
                return None
            encoded = payload[13:45]
            decoded = []
            for i in range(0, 32, 2):
                c = ((encoded[i] - ord("A")) << 4) | (encoded[i+1] - ord("A"))
                if 32 <= c <= 126:
                    decoded.append(chr(c))
            name = "".join(decoded).strip()
            return name if name else None
        except Exception:
            return None

    def _parse_mdns_name(self, payload):
        if len(payload) < 12:
            return None
        try:
            idx = 12
            parts = []
            while idx < len(payload):
                length = payload[idx]
                if length == 0:
                    break
                if length >= 192:
                    break
                idx += 1
                if idx + length > len(payload):
                    break
                part = payload[idx:idx + length].decode("utf-8", errors="replace")
                parts.append(part)
                idx += length
            if parts:
                full = ".".join(parts)
                if "local" in full.lower():
                    return full
        except Exception:
            pass
        return None

    def _render_nameplates(self, ui):
        items = []
        with self._lock:
            devices = list(self._connected_devices.values())

        if not devices:
            items.append(ui.card([
                ui.row([
                    ui.text("🏷️  CONNECTED DEVICE NAMEPLATES", "labelSmall", color="secondary"),
                    ui.text("0 Detected", "labelSmall", color="muted"),
                ]),
                ui.text("No client device connected to mobile hotspot yet.", "bodySmall"),
                ui.text("Turn on Mobile Hotspot and connect your Laptop, Phone, or TV. Once connected, its nameplate will stack here automatically.", "labelSmall", color="muted"),
                ui.row([
                    self._button(ui, "🔄 Scan Connected Clients", self._poll_system_clients, style="tonal"),
                ])
            ]))
            return items

        # Stack Header
        items.append(ui.row([
            ui.text("🏷️  CONNECTED DEVICE NAMEPLATES ({})".format(len(devices)), "labelSmall", color="primary"),
            self._button(ui, "🔄 Rescan", self._poll_system_clients, style="text"),
        ]))

        # Stacked Cards: Most recently active devices first
        sorted_devices = sorted(devices, key=lambda d: d.get("last_seen", 0), reverse=True)
        now = time.time()

        for dev in sorted_devices:
            ip = dev.get("ip", "")
            mac = dev.get("mac", "")
            name = dev.get("name", "Unknown Device")
            category = dev.get("category", "Client")
            vendor = dev.get("vendor", "Unknown Vendor")
            pkts = dev.get("pkts", 0)
            bcount = dev.get("bytes", 0)
            last_seen = dev.get("last_seen", 0)
            is_active = (now - last_seen < 15) if last_seen else False

            status_text = "🟢 Active Now" if is_active else "⚪ Connected"
            domains_list = list(dev.get("domains", []))[:3]
            domains_str = " · ".join(domains_list) if domains_list else "Awaiting web requests"

            cat_icon = "💻" if "Laptop" in category else "📱" if "Mobile" in category else "📺" if "TV" in category else "📟" if "Tablet" in category else "🌐"

            card_children = [
                ui.row([
                    ui.text("{}  {}".format(cat_icon, name), "titleMedium", color="primary"),
                    ui.text("[{}]".format(category), "labelSmall", color="secondary"),
                ]),
                ui.row([
                    ui.text("IP: " + ip, "bodyMedium"),
                    ui.text("ID/MAC: " + mac, "labelSmall", color="muted"),
                ]),
                ui.row([
                    ui.text("Vendor: " + vendor, "labelSmall", color="muted"),
                    ui.text("Traffic: {:,} pkts ({:.1f} KB)".format(pkts, bcount / 1024), "labelSmall", color="secondary"),
                    ui.text(status_text, "labelSmall", color="primary" if is_active else "muted"),
                ]),
                ui.text("Live Activity: " + domains_str, "labelSmall", color="muted"),
            ]
            items.append(ui.card(card_children))

        return items

    def _detect_shell(self):
        try:
            uid = self._try_shell_uid("root")
            if uid == "0":
                self._shell_mode = "root"
                self._uid = "0"
                return
        except Exception:
            pass

        try:
            uid = self._try_shell_uid("shizuku")
            if uid in ("0", "2000"):
                self._shell_mode = "shizuku"
                self._uid = uid
                return
        except Exception:
            pass

        self._shell_mode = "none"
        self._uid = ""

    def _try_shell_uid(self, mode):
        raw = None
        try:
            if mode == "shizuku" and hasattr(self, "shizuku"):
                raw = self.shizuku("id -u")
            elif mode == "root" and hasattr(self, "root"):
                raw = self.root("id -u")
            elif mode == "root":
                res = subprocess.run(["su", "-c", "id -u"], stdout=subprocess.PIPE,
                                     stderr=subprocess.PIPE, text=True, timeout=1.5)
                raw = res.stdout.strip() if res.returncode == 0 else ""
            else:
                return ""
        except Exception as exc:
            self._log("warning", "{} id -u: {}".format(mode, str(exc)[:150]))
            return ""

        text = ""
        if isinstance(raw, bytes):
            try:
                text = raw.decode("utf-8", errors="replace")
            except Exception:
                text = ""
        elif isinstance(raw, dict):
            for key in ("out", "stdout", "output"):
                if raw.get(key):
                    text = str(raw[key])
                    break
        elif raw is not None:
            text = str(raw)

        text = text.strip()
        if not text:
            return ""
        first = text.splitlines()[0].strip()
        if first in ("2000", "0"):
            return first
        m = re.search(r"uid=(\d+)", first)
        if m and m.group(1) in ("2000", "0"):
            return m.group(1)
        return ""

    def _load_state(self):
        try:
            saved = self.get_setting(self.STATE_KEY, {})
            if isinstance(saved, str):
                saved = json.loads(saved)
            if isinstance(saved, dict):
                self._iface = saved.get("iface", self.DEFAULT_IFACE)
                self._ring_limit = int(saved.get("ring_limit", 1500))
                self._auto_save_pcap = bool(saved.get("auto_save", False))
                self._auto_scroll = bool(saved.get("auto_scroll", True))
                self._packets = deque(maxlen=self._ring_limit)
        except Exception:
            pass

    def _save_state(self):
        try:
            self.set_setting(self.STATE_KEY, {
                "iface": self._iface,
                "ring_limit": self._ring_limit,
                "auto_save": self._auto_save_pcap,
                "auto_scroll": self._auto_scroll,
            })
        except Exception:
            pass

    def _log(self, level, message):
        try:
            if hasattr(self, "log"):
                self.log(level, str(message))
        except Exception:
            pass

    def _toast(self, message):
        try:
            if hasattr(self, "toast"):
                self.toast(str(message))
        except Exception:
            pass

    def _refresh(self, force=False):
        if not self._ready:
            return
        try:
            now = time.monotonic()
            with self._ui_lock:
                if not force:
                    if (now - self._last_ui_refresh) < (self.UI_THROTTLE_MS / 1000.0):
                        return
                self._last_ui_refresh = now
            self.refresh()
        except Exception:
            pass

    # ═══════════ DISSECTION ENGINE ═══════════

    @staticmethod
    def _mac_to_str(raw):
        return ":".join("{:02x}".format(b) for b in raw)

    @staticmethod
    def _ip_to_str(raw):
        return ".".join(str(b) for b in raw)

    @staticmethod
    def _parse_dns(payload):
        if len(payload) < 12:
            return None
        try:
            tid, flags, qdcount, ancount, nscount, arcount = struct.unpack("!HHHHHH", payload[:12])
            is_response = bool(flags & 0x8000)
            idx = 12
            qname_parts = []
            while idx < len(payload):
                length = payload[idx]
                if length == 0:
                    idx += 1
                    break
                idx += 1
                if idx + length > len(payload):
                    break
                qname_parts.append(payload[idx:idx + length].decode("ascii", "ignore"))
                idx += length
            qname = ".".join(qname_parts)
            qtype = 0
            if idx + 2 <= len(payload):
                qtype = struct.unpack("!H", payload[idx:idx + 2])[0]
            type_str = "A" if qtype == 1 else "AAAA" if qtype == 28 else "CNAME" if qtype == 5 else "PTR" if qtype == 12 else "HTTPS" if qtype == 65 else "Type-{}".format(qtype)
            return {
                "id": tid,
                "qname": qname,
                "qtype": type_str,
                "is_response": is_response,
                "answers": ancount,
            }
        except Exception:
            return None

    @staticmethod
    def _parse_tls_sni(payload):
        if len(payload) < 9:
            return None
        try:
            content_type, ver, length = struct.unpack("!BHH", payload[:5])
            if content_type != 22:  # Handshake
                return None
            hs_type = payload[5]
            if hs_type != 1:  # Client Hello
                return None
            idx = 9 + 2 + 32  # skip version & random
            if idx >= len(payload):
                return None
            sess_id_len = payload[idx]
            idx += 1 + sess_id_len
            if idx + 2 > len(payload):
                return None
            cs_len = struct.unpack("!H", payload[idx:idx + 2])[0]
            idx += 2 + cs_len
            if idx >= len(payload):
                return None
            comp_len = payload[idx]
            idx += 1 + comp_len
            if idx + 2 > len(payload):
                return None
            ext_total_len = struct.unpack("!H", payload[idx:idx + 2])[0]
            idx += 2
            end_ext = idx + ext_total_len
            while idx + 4 <= end_ext and idx + 4 <= len(payload):
                etype, elen = struct.unpack("!HH", payload[idx:idx + 4])
                idx += 4
                if etype == 0:  # server_name (SNI)
                    if idx + 2 <= len(payload):
                        s_idx = idx + 2
                        if s_idx + 3 <= len(payload):
                            ntype, nlen = s_idx, struct.unpack("!H", payload[s_idx + 1:s_idx + 3])[0]
                            host = payload[s_idx + 3:s_idx + 3 + nlen].decode("utf-8", "ignore")
                            return host
                idx += elen
        except Exception:
            pass
        return None

    @staticmethod
    def _parse_http(payload):
        try:
            prefix = payload[:2048].decode("utf-8", "ignore")
            lines = prefix.split("\r\n")
            if not lines or not lines[0]:
                return None
            first = lines[0]
            verbs = ("GET ", "POST ", "HEAD ", "PUT ", "DELETE ", "OPTIONS ", "HTTP/")
            if any(first.startswith(v) for v in verbs):
                headers = {}
                for line in lines[1:]:
                    if ": " in line:
                        k, v = line.split(": ", 1)
                        headers[k.strip().lower()] = v.strip()
                return {
                    "first_line": first,
                    "host": headers.get("host", ""),
                    "user_agent": headers.get("user-agent", ""),
                }
        except Exception:
            pass
        return None

    def _dissect_frame(self, raw, ts_epoch=None, link_type=1):
        ts = ts_epoch if ts_epoch is not None else time.time()
        pkt = {
            "time": ts,
            "len": len(raw),
            "raw": raw,
            "eth": None,
            "ip": None,
            "arp": None,
            "l4": None,
            "app": None,
            "proto": "RAW",
            "src": "",
            "dst": "",
            "info": "",
            "is_hotspot": False,
        }

        offset = 0
        eth_type = 0

        if link_type == 113:  # SLL (Linux Cooked)
            if len(raw) < 16:
                return pkt
            pkt_type, arphrd_type, ll_len = struct.unpack("!HHH", raw[:6])
            eth_type = struct.unpack("!H", raw[14:16])[0]
            offset = 16
            pkt["eth"] = {
                "type": "Linux Cooked (SLL)",
                "proto": hex(eth_type),
            }
        else:  # Ethernet II
            if len(raw) < 14:
                return pkt
            dst_mac = self._mac_to_str(raw[:6])
            src_mac = self._mac_to_str(raw[6:12])
            eth_type = struct.unpack("!H", raw[12:14])[0]
            offset = 14
            pkt["eth"] = {
                "src": src_mac,
                "dst": dst_mac,
                "type": hex(eth_type),
            }

        # ARP
        if eth_type == 0x0806 and len(raw) >= offset + 28:
            arp_raw = raw[offset:offset + 28]
            hw_type, proto_type, hw_len, proto_len, opcode = struct.unpack("!HHBBH", arp_raw[:8])
            s_mac = self._mac_to_str(arp_raw[8:14])
            s_ip = self._ip_to_str(arp_raw[14:18])
            t_mac = self._mac_to_str(arp_raw[18:24])
            t_ip = self._ip_to_str(arp_raw[24:28])
            pkt["proto"] = "ARP"
            pkt["src"] = s_ip
            pkt["dst"] = t_ip
            op_str = "Request" if opcode == 1 else "Reply" if opcode == 2 else str(opcode)
            pkt["info"] = "Who has {}? Tell {} ({})".format(t_ip, s_ip, op_str) if opcode == 1 else "{} is at {}".format(s_ip, s_mac)
            pkt["arp"] = {
                "opcode": op_str,
                "sender_mac": s_mac,
                "sender_ip": s_ip,
                "target_mac": t_mac,
                "target_ip": t_ip,
            }
            # Register in device nameplate table
            if s_ip and not s_ip.endswith(".1") and not s_ip.endswith(".255"):
                self._register_or_update_device(s_ip, mac=s_mac)
            return pkt

        # IPv4
        if eth_type == 0x0800 and len(raw) >= offset + 20:
            ip_hdr = raw[offset:offset + 20]
            ver_ihl, tos, tot_len, ident, flags_frag, ttl, proto_num, chk = struct.unpack("!BBHHHBBH", ip_hdr[:12])
            ihl = (ver_ihl & 0x0F) * 4
            src_ip = self._ip_to_str(ip_hdr[12:16])
            dst_ip = self._ip_to_str(ip_hdr[16:20])
            pkt["src"] = src_ip
            pkt["dst"] = dst_ip
            proto_name = self.IP_PROTO_MAP.get(proto_num, "IP-{}".format(proto_num))
            pkt["proto"] = proto_name
            pkt["ip"] = {
                "version": 4,
                "ihl": ihl,
                "tos": tos,
                "total_len": tot_len,
                "id": ident,
                "ttl": ttl,
                "proto": proto_name,
                "src": src_ip,
                "dst": dst_ip,
            }

            # Check if traffic belongs to hotspot subnet
            is_hotspot_ip = (
                src_ip.startswith("10.") or src_ip.startswith("192.168.43.") or
                dst_ip.startswith("10.") or dst_ip.startswith("192.168.43.")
            )
            if is_hotspot_ip:
                pkt["is_hotspot"] = True
                client_ip = src_ip if (src_ip.startswith("10.") or src_ip.startswith("192.168.43.")) else dst_ip
                if not client_ip.endswith(".1") and not client_ip.endswith(".255"):
                    src_mac = pkt.get("eth", {}).get("src") if pkt.get("eth") else ""
                    self._register_or_update_device(client_ip, mac=src_mac, ttl=ttl)
                    with self._lock:
                        if client_ip in self._connected_devices:
                            self._connected_devices[client_ip]["pkts"] += 1
                            self._connected_devices[client_ip]["bytes"] += len(raw)
                            self._connected_devices[client_ip]["last_seen"] = ts
                        self._hotspot_clients.add(client_ip)

            l4_offset = offset + ihl
            payload = raw[l4_offset:]

            # TCP
            if proto_num == 6 and len(payload) >= 20:
                sport, dport, seq, ack, offset_flags, window, chk, urp = struct.unpack("!HHIIHHHH", payload[:20])
                tcp_hdr_len = ((offset_flags >> 12) & 0x0F) * 4
                flags_val = offset_flags & 0x01FF
                flag_names = []
                if flags_val & 0x02: flag_names.append("SYN")
                if flags_val & 0x10: flag_names.append("ACK")
                if flags_val & 0x01: flag_names.append("FIN")
                if flags_val & 0x04: flag_names.append("RST")
                if flags_val & 0x08: flag_names.append("PSH")
                flags_str = "[" + ", ".join(flag_names) + "]" if flag_names else ""

                pkt["l4"] = {
                    "type": "TCP",
                    "sport": sport,
                    "dport": dport,
                    "seq": seq,
                    "ack": ack,
                    "flags": flags_str,
                    "win": window,
                }
                pkt["info"] = "{} → {} {} Len={}".format(sport, dport, flags_str, len(payload) - tcp_hdr_len)

                app_payload = payload[tcp_hdr_len:]
                # Try TLS
                if dport == 443 or sport == 443 or (app_payload and app_payload[0] == 22):
                    sni = self._parse_tls_sni(app_payload)
                    if sni:
                        pkt["proto"] = "TLS"
                        pkt["info"] = "Client Hello (SNI: {})".format(sni)
                        pkt["app"] = {"type": "TLS", "sni": sni}
                        self._hotspot_domains[sni] += 1
                        if pkt["is_hotspot"]:
                            client_ip = src_ip if src_ip.startswith("10.") else dst_ip
                            with self._lock:
                                if client_ip in self._connected_devices:
                                    self._connected_devices[client_ip]["domains"].add(sni)
                    else:
                        pkt["proto"] = "HTTPS (TLS)"
                # Try HTTP
                if dport in (80, 8080) or sport in (80, 8080):
                    http_data = self._parse_http(app_payload)
                    if http_data:
                        pkt["proto"] = "HTTP"
                        pkt["info"] = http_data["first_line"]
                        pkt["app"] = http_data
                        host = http_data.get("host")
                        if host:
                            self._hotspot_domains[host] += 1
                            if pkt["is_hotspot"]:
                                client_ip = src_ip if src_ip.startswith("10.") else dst_ip
                                with self._lock:
                                    if client_ip in self._connected_devices:
                                        self._connected_devices[client_ip]["domains"].add(host)

            # UDP
            elif proto_num == 17 and len(payload) >= 8:
                sport, dport, ulen, chk = struct.unpack("!HHHH", payload[:8])
                app_payload = payload[8:]
                pkt["l4"] = {
                    "type": "UDP",
                    "sport": sport,
                    "dport": dport,
                    "len": ulen,
                }
                pkt["info"] = "{} → {} Len={}".format(sport, dport, len(app_payload))

                # DHCP (Ports 67, 68) - Device Name & Vendor Fingerprinting
                if sport in (67, 68) or dport in (67, 68):
                    dhcp = self._parse_dhcp(app_payload)
                    if dhcp:
                        pkt["proto"] = "DHCP"
                        pkt["info"] = "DHCP {} (Host: {}, MAC: {})".format(
                            dhcp.get("msg_type") or "Msg",
                            dhcp.get("hostname") or "n/a",
                            dhcp.get("mac") or "n/a"
                        )
                        pkt["app"] = dhcp
                        client_ip = src_ip if src_ip != "0.0.0.0" else dst_ip
                        self._register_or_update_device(
                            client_ip, mac=dhcp.get("mac"), name=dhcp.get("hostname"),
                            vendor_class=dhcp.get("vendor_class")
                        )

                # NetBIOS Name Service (Port 137) - Windows Computer Name
                elif sport == 137 or dport == 137:
                    nb_name = self._parse_nbns_name(app_payload)
                    if nb_name:
                        pkt["proto"] = "NBNS"
                        pkt["info"] = "NetBIOS Name: " + nb_name
                        pkt["app"] = {"type": "NBNS", "name": nb_name}
                        self._register_or_update_device(src_ip, name=nb_name, vendor_class="Windows NetBIOS")

                # mDNS (Port 5353) - Apple / Linux .local hostnames
                elif sport == 5353 or dport == 5353:
                    mdns_name = self._parse_mdns_name(app_payload)
                    if mdns_name:
                        pkt["proto"] = "mDNS"
                        pkt["info"] = "mDNS Host: " + mdns_name
                        pkt["app"] = {"type": "mDNS", "name": mdns_name}
                        self._register_or_update_device(src_ip, name=mdns_name)

                # Standard DNS (Port 53)
                elif sport == 53 or dport == 53:
                    dns_info = self._parse_dns(app_payload)
                    if dns_info:
                        pkt["proto"] = "DNS"
                        kind = "response" if dns_info["is_response"] else "query"
                        pkt["info"] = "Standard {} {} {}".format(kind, dns_info["qtype"], dns_info["qname"])
                        pkt["app"] = dns_info
                        qname = dns_info.get("qname")
                        if qname:
                            self._hotspot_domains[qname] += 1
                            if pkt["is_hotspot"]:
                                client_ip = src_ip if (src_ip.startswith("10.") or src_ip.startswith("192.168.43.")) else dst_ip
                                with self._lock:
                                    if client_ip in self._connected_devices:
                                        self._connected_devices[client_ip]["domains"].add(qname)

            # ICMP
            elif proto_num == 1 and len(payload) >= 4:
                itype, icode = struct.unpack("!BB", payload[:2])
                type_name = "Echo Reply" if itype == 0 else "Dest Unreach" if itype == 3 else "Echo Request" if itype == 8 else "TTL Expired" if itype == 11 else "Type-{}".format(itype)
                pkt["l4"] = {"type": "ICMP", "itype": itype, "icode": icode, "desc": type_name}
                pkt["info"] = "ICMP {} (code={})".format(type_name, icode)

        return pkt

    # ═══════════ LINUX TERMINAL FORMATTER ═══════════

    @staticmethod
    def _format_terminal_line(pkt, idx):
        # Format identical to Linux tshark / tcpdump -nn line output
        ts = time.strftime("%H:%M:%S", time.localtime(pkt["time"])) + ".{:03d}".format(int((pkt["time"] % 1) * 1000))
        proto = "[{:<5}]".format(pkt["proto"][:5])
        src = pkt["src"] or "local"
        dst = pkt["dst"] or "bcast"
        if pkt.get("l4"):
            l4 = pkt["l4"]
            if l4.get("sport") and l4.get("dport"):
                src = "{}:{}".format(src, l4["sport"])
                dst = "{}:{}".format(dst, l4["dport"])

        sz = "{} B".format(pkt["len"]) if pkt["len"] < 1024 else "{:.1f} KB".format(pkt["len"] / 1024)
        info = pkt["info"][:42]
        return "{:>4}  {} {} {:<19} → {:<19}  {} ({})".format(
            idx, ts, proto, src[:19], dst[:19], info, sz
        )

    # ═══════════ HEX & ASCII GENERATOR ═══════════

    @staticmethod
    def _generate_hex_dump(raw, max_bytes=512):
        lines = []
        truncated = False
        data = raw
        if len(data) > max_bytes:
            data = data[:max_bytes]
            truncated = True

        for i in range(0, len(data), 16):
            chunk = data[i:i + 16]
            hex_part1 = " ".join("{:02x}".format(b) for b in chunk[:8])
            hex_part2 = " ".join("{:02x}".format(b) for b in chunk[8:])
            hex_str = "{:<23}  {:<23}".format(hex_part1, hex_part2)
            ascii_str = "".join((chr(b) if 32 <= b < 127 else ".") for b in chunk)
            lines.append("{:04x}   {}   |{}|".format(i, hex_str, ascii_str))

        if truncated:
            lines.append("... [truncated to {} bytes]".format(max_bytes))
        return "\n".join(lines)

    # ═══════════ PCAP ENGINE ═══════════

    def _export_pcap(self, path=None):
        if not self._packets:
            self._toast("No packets captured to export")
            return None
        if not path:
            ts = time.strftime("%Y%m%d_%H%M%S")
            path = "/sdcard/Download/packetshark_{}.pcap".format(ts)

        try:
            # PCAP Global Header: magic (0xa1b2c3d4), v2.4, snaplen=65535, network=1 (Ethernet)
            header = struct.pack("<IHHIIII", 0xa1b2c3d4, 2, 4, 0, 0, 65535, 1)
            with open(path, "wb") as f:
                f.write(header)
                with self._lock:
                    for pkt in self._packets:
                        raw = pkt["raw"]
                        ts = pkt["time"]
                        ts_sec = int(ts)
                        ts_usec = int((ts - ts_sec) * 1_000_000)
                        rec_hdr = struct.pack("<IIII", ts_sec, ts_usec, len(raw), len(raw))
                        f.write(rec_hdr)
                        f.write(raw)
            self._log("success", "Exported {} packets to {}".format(len(self._packets), path))
            self._toast("💾 PCAP Saved: " + os.path.basename(path))
            return path
        except Exception as exc:
            self._toast("Export error: " + str(exc)[:60])
            return None

    def _import_pcap(self, path):
        if not os.path.exists(path):
            self._toast("File not found")
            return
        sz = os.path.getsize(path)
        if sz > self.MAX_PCAP_FILE:
            self._toast("PCAP exceeds 100 MB limit")
            return

        def worker():
            try:
                with open(path, "rb") as f:
                    magic_bytes = f.read(4)
                    if len(magic_bytes) < 4:
                        raise ValueError("File too short")
                    magic = struct.unpack("<I", magic_bytes)[0]
                    endian = "<"
                    if magic == 0xa1b2c3d4:
                        endian = "<"
                    elif magic == 0xd4c3b2a1:
                        endian = ">"
                    else:
                        raise ValueError("Unsupported PCAP magic: " + hex(magic))

                    hdr_bytes = f.read(20)
                    v_maj, v_min, tz, sigf, snap, net = struct.unpack(endian + "HHIIII", hdr_bytes)

                    parsed = []
                    while not self._stop.is_set():
                        rec_bytes = f.read(16)
                        if len(rec_bytes) < 16:
                            break
                        ts_sec, ts_usec, incl_len, orig_len = struct.unpack(endian + "IIII", rec_bytes)
                        pkt_data = f.read(incl_len)
                        if len(pkt_data) < incl_len:
                            break
                        ts = ts_sec + (ts_usec / 1_000_000.0)
                        dissected = self._dissect_frame(pkt_data, ts_epoch=ts, link_type=net)
                        parsed.append(dissected)
                        if len(parsed) >= self._ring_limit:
                            break

                with self._lock:
                    self._packets.clear()
                    self._top_talkers.clear()
                    self._proto_counts.clear()
                    self._hotspot_domains.clear()
                    self._client_traffic.clear()
                    for p in parsed:
                        self._packets.append(p)
                        self._top_talkers[p["src"]] += p["len"]
                        self._proto_counts[p["proto"]] += 1
                    self._pkt_counter = len(self._packets)

                self._page = "live"
                self._toast("✅ Loaded {:,} packets from PCAP".format(len(self._packets)))
            except Exception as exc:
                self._toast("PCAP error: " + str(exc)[:60])
            finally:
                self._refresh(force=True)

        threading.Thread(target=worker, daemon=True).start()

    def _generate_synthetic_sample(self):
        packets = []
        now = time.time()

        # 1. ARP Request
        arp_raw = bytes.fromhex("ffffffffffff123456789abc08060001080006040001123456789abc0abb80990000000000000abb8001")
        packets.append(self._dissect_frame(arp_raw, now - 5.0))

        # 2. DNS query for 'google.com' (Laptop 10.187.128.99)
        dns_body = struct.pack("!HHHHHH", 0x4321, 0x0100, 1, 0, 0, 0) + b"\x06google\x03com\x00\x00\x01\x00\x01"
        udp_hdr = struct.pack("!HHHH", 54311, 53, len(dns_body) + 8, 0)
        ip_hdr = struct.pack("!BBHHHBBH4s4s", 0x45, 0, len(udp_hdr) + len(dns_body) + 20, 101, 0, 64, 17, 0,
                             bytes([10, 187, 128, 99]), bytes([8, 8, 8, 8]))
        eth = bytes.fromhex("aabbccddeeff123456789abc0800")
        packets.append(self._dissect_frame(eth + ip_hdr + udp_hdr + dns_body, now - 4.1))

        # 3. TLS Client Hello with SNI 'github.com' (Laptop 10.187.128.99)
        sni = struct.pack("!HH", 0, 14) + struct.pack("!HB", 12, 0) + struct.pack("!H", 10) + b"github.com"
        exts = struct.pack("!H", len(sni)) + sni
        ch_body = struct.pack("!H", 0x0303) + b"\x00" * 32 + b"\x00" + struct.pack("!H", 2) + b"\x00\x9c\x01\x00" + exts
        hs = struct.pack("!B", 1) + len(ch_body).to_bytes(3, "big") + ch_body
        tls_rec = struct.pack("!BHH", 22, 0x0301, len(hs)) + hs
        tcp_hdr = struct.pack("!HHIIHHHH", 51234, 443, 1000, 5000, 0x5018, 65535, 0, 0)
        ip_hdr = struct.pack("!BBHHHBBH4s4s", 0x45, 0, len(tcp_hdr) + len(tls_rec) + 20, 102, 0x4000, 128, 6, 0,
                             bytes([10, 187, 128, 99]), bytes([140, 82, 121, 3]))
        packets.append(self._dissect_frame(eth + ip_hdr + tcp_hdr + tls_rec, now - 3.0))

        # 4. HTTP GET request
        http_body = b"GET /index.html HTTP/1.1\r\nHost: example.org\r\nUser-Agent: Mozilla/5.0 (Laptop)\r\n\r\n"
        tcp_hdr3 = struct.pack("!HHIIHHHH", 51240, 80, 2000, 100, 0x5018, 64240, 0, 0)
        ip_hdr3 = struct.pack("!BBHHHBBH4s4s", 0x45, 0, len(tcp_hdr3) + len(http_body) + 20, 105, 0x4000, 128, 6, 0,
                              bytes([10, 187, 128, 99]), bytes([93, 184, 216, 34]))
        packets.append(self._dissect_frame(eth + ip_hdr3 + tcp_hdr3 + http_body, now - 2.2))

        # 5. TLS Client Hello with SNI 'youtube.com'
        sni2 = struct.pack("!HH", 0, 15) + struct.pack("!HB", 13, 0) + struct.pack("!H", 11) + b"youtube.com"
        exts2 = struct.pack("!H", len(sni2)) + sni2
        ch_body2 = struct.pack("!H", 0x0303) + b"\x00" * 32 + b"\x00" + struct.pack("!H", 2) + b"\x00\x9c\x01\x00" + exts2
        hs2 = struct.pack("!B", 1) + len(ch_body2).to_bytes(3, "big") + ch_body2
        tls_rec2 = struct.pack("!BHH", 22, 0x0301, len(hs2)) + hs2
        tcp_hdr2 = struct.pack("!HHIIHHHH", 51236, 443, 3000, 6000, 0x5018, 65535, 0, 0)
        ip_hdr2 = struct.pack("!BBHHHBBH4s4s", 0x45, 0, len(tcp_hdr2) + len(tls_rec2) + 20, 104, 0x4000, 128, 6, 0,
                              bytes([10, 187, 128, 99]), bytes([142, 250, 190, 46]))
        packets.append(self._dissect_frame(eth + ip_hdr2 + tcp_hdr2 + tls_rec2, now - 1.5))

        # 6. ICMP Ping probe
        icmp = struct.pack("!BBHHH", 8, 0, 0, 0x55aa, 1) + b"PacketSharkDiagnosticProbe12345678"
        ip_hdr4 = struct.pack("!BBHHHBBH4s4s", 0x45, 0, len(icmp) + 20, 106, 0, 64, 1, 0,
                              bytes([10, 187, 128, 99]), bytes([10, 187, 128, 1]))
        packets.append(self._dissect_frame(eth + ip_hdr4 + icmp, now - 0.5))

        with self._lock:
            for p in packets:
                self._packets.append(p)
                self._top_talkers[p["src"]] += p["len"]
                self._proto_counts[p["proto"]] += 1
            self._pkt_counter = len(self._packets)

        self._toast("Generated 6 realistic sample packets")
        self._refresh(force=True)

    # ═══════════ REAL-TIME CAPTURE ENGINE ═══════════

    def _start_capture(self):
        if self._capturing:
            return
        self._stop.clear()
        self._capturing = True
        self._start_time = time.time()
        self._bytes_total = 0
        self._pkt_counter = 0

        def capture_worker():
            self._log("info", "Starting live capture on interface: {}".format(self._iface))

            # Strategy 1: Root tcpdump pipe streaming raw PCAP frames
            tcpdump_cmd = "tcpdump -i {} -U -s 0 -w - 2>/dev/null".format(self._iface)
            proc = None
            try:
                if self._shell_mode == "root":
                    proc = subprocess.Popen(["su", "-c", tcpdump_cmd],
                                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
                if proc and proc.stdout:
                    pcap_hdr = proc.stdout.read(24)
                    if len(pcap_hdr) == 24:
                        endian = "<" if pcap_hdr[:4] == b"\xd4\xc3\xb2\xa1" else ">"
                        net_link = struct.unpack(endian + "I", pcap_hdr[20:24])[0]
                        while not self._stop.is_set():
                            rec_hdr = proc.stdout.read(16)
                            if len(rec_hdr) < 16:
                                break
                            ts_sec, ts_usec, incl_len, orig_len = struct.unpack(endian + "IIII", rec_hdr)
                            pkt_raw = proc.stdout.read(incl_len)
                            if len(pkt_raw) < incl_len:
                                break
                            ts = ts_sec + (ts_usec / 1_000_000.0)
                            dissected = self._dissect_frame(pkt_raw, ts_epoch=ts, link_type=net_link)
                            with self._lock:
                                self._packets.append(dissected)
                                self._pkt_counter += 1
                                self._bytes_total += len(pkt_raw)
                                self._top_talkers[dissected["src"]] += len(pkt_raw)
                                self._proto_counts[dissected["proto"]] += 1
                            # Real-time UI refresh signal
                            self._refresh()
                    proc.kill()
                    return
            except Exception as exc:
                self._log("warning", "tcpdump pipe: " + str(exc)[:100])

            # Strategy 2: Raw Socket via Python (Root)
            try:
                raw_sock = socket.socket(socket.AF_PACKET, socket.SOCK_RAW, socket.ntohs(0x0003))
                raw_sock.settimeout(0.3)
                try:
                    raw_sock.bind((self._iface, 0))
                except Exception:
                    pass

                while not self._stop.is_set():
                    try:
                        pkt_raw, addr = raw_sock.recvfrom(self.SNAP_LEN)
                        if pkt_raw:
                            dissected = self._dissect_frame(pkt_raw, time.time(), link_type=1)
                            with self._lock:
                                self._packets.append(dissected)
                                self._pkt_counter += 1
                                self._bytes_total += len(pkt_raw)
                                self._top_talkers[dissected["src"]] += len(pkt_raw)
                                self._proto_counts[dissected["proto"]] += 1
                            # Real-time UI refresh signal
                            self._refresh()
                    except socket.timeout:
                        continue
                    except Exception:
                        break
                raw_sock.close()
                return
            except Exception as exc:
                self._log("warning", "Raw socket: " + str(exc)[:100])

            # Strategy 3: Shizuku / Shell Socket Poll
            self._log("info", "Monitoring network activity via shell state")
            while not self._stop.is_set():
                time.sleep(0.5)

            self._log("info", "Capture stopped")

        self._thread = threading.Thread(target=capture_worker, daemon=True)
        self._thread.start()
        self._refresh(force=True)

    def _stop_capture(self):
        self._stop.set()
        self._capturing = False
        if self._auto_save_pcap and self._packets:
            self._export_pcap()
        self._refresh(force=True)

    def _clear_capture(self):
        with self._lock:
            self._packets.clear()
            self._top_talkers.clear()
            self._proto_counts.clear()
            self._hotspot_domains.clear()
            self._hotspot_clients.clear()
            self._client_traffic.clear()
            self._pkt_counter = 0
            self._bytes_total = 0
            self._selected_pkt_idx = None
        self._toast("Capture cleared")
        self._refresh(force=True)

    # ═══════════ UI HELPERS ═══════════

    def _value(self, setter, refresh=True):
        def handler(val):
            setter(val)
            if refresh:
                self._refresh(force=True)
        return handler

    def _set_query(self, query):
        self._filter_query = str(query or "")

    def _toggle_auto_scroll(self):
        self._auto_scroll = not self._auto_scroll
        self._toast("Auto-scroll: " + ("ON" if self._auto_scroll else "PAUSED"))
        self._refresh(force=True)

    def _bind(self, callback, *bound_args):
        def invoke(*args, **kwargs):
            if not self._ready:
                return None
            try:
                return callback(*bound_args)
            except Exception as exc:
                self._log("error", str(exc)[:200])
                self._toast("Action error: " + str(exc)[:50])
            finally:
                self._refresh(force=True)
            return None
        return invoke

    def _button(self, ui, title, callback, *args, enabled=True, style="tonal"):
        return ui.button(title, self._bind(callback, *args), enabled=enabled, style=style)

    def _nav_button(self, ui, label, page_name, is_primary=False):
        is_active = (self._page == page_name)
        style = "filled" if is_active else ("tonal" if is_primary else "outlined")
        return ui.button(label, self._bind(self._go, page_name), style=style)

    def _go(self, page):
        self._page = page
        self._refresh(force=True)

    def _bottom_nav(self, ui):
        cur = self._page
        return ui.card([
            ui.row([
                ui.text("🦈  PACKETSHARK", "labelSmall", color="secondary"),
                ui.text("View: " + cur.upper(), "labelSmall", color="primary"),
            ]),
            ui.divider(),
            ui.row([
                self._nav_button(ui, "🖥️ Live Console", "live", is_primary=True),
                self._nav_button(ui, "📋 Packets", "packets"),
                self._nav_button(ui, "🔍 Detail", "detail"),
            ]),
            ui.row([
                self._nav_button(ui, "📊 Analytics", "stats"),
                self._nav_button(ui, "📂 PCAP", "pcap"),
                self._nav_button(ui, "⚙️ Config", "settings"),
            ]),
        ])

    # ═══════════ SCREEN 1: LIVE TERMINAL CONSOLE ═══════════

    def _live_console_ui(self, ui):
        children = []

        # 1. Live Linux-Style Header Dashboard
        mode_pill = "🟢 ROOT" if self._shell_mode == "root" else "🟡 SHIZUKU" if self._shell_mode == "shizuku" else "⚪ OFFLINE"
        elapsed = max(1.0, time.time() - self._start_time) if self._capturing else 1.0
        pkt_count = len(self._packets)
        rate = pkt_count / elapsed if self._capturing else 0.0
        kb_sec = (self._bytes_total / 1024) / elapsed if self._capturing else 0.0

        client_tag = ""
        if self._hotspot_clients:
            client_tag = " · Laptop: {}".format(", ".join(list(self._hotspot_clients)[:2]))

        status_headline = "LIVE STREAM ACTIVE ({})".format(self._iface.upper()) if self._capturing else "CAPTURE IDLE ({})".format(self._iface.upper())

        children.append(ui.card([
            ui.row([
                ui.text("⚡  " + status_headline, "titleSmall", color="primary" if self._capturing else "secondary"),
                ui.text(mode_pill, "labelSmall", color="secondary"),
            ]),
            ui.row([
                ui.text("Pkts: {:,}".format(pkt_count), "bodyMedium"),
                ui.text("Rate: {:.1f} p/s".format(rate), "labelSmall", color="muted"),
                ui.text("Throughput: {:.1f} KB/s".format(kb_sec), "labelSmall", color="muted"),
            ]),
            ui.text("Interface: {} [Hotspot Subnet 10.x]{}".format(self._iface, client_tag), "labelSmall", color="secondary"),
            ui.divider(),
            ui.row([
                self._button(ui, "⏹ Stop" if self._capturing else "▶ Start Live Stream",
                             self._stop_capture if self._capturing else self._start_capture,
                             style="filled" if not self._capturing else "tonal"),
                self._button(ui, "⏸ Pause" if self._auto_scroll else "▶ Follow",
                             self._toggle_auto_scroll, style="outlined"),
                self._button(ui, "🗑 Clear", self._clear_capture, enabled=not self._capturing),
            ]),
        ]))

        # 2. Filter Pills & Text Search
        filter_buttons = []
        for p in ("ALL", "HOTSPOT", "DNS", "TLS", "TCP", "UDP"):
            is_f_active = (self._filter_proto == p)
            cb = lambda pf=p: self._set_filter(pf)
            filter_buttons.append(ui.button(p, self._bind(cb), style="filled" if is_f_active else "outlined"))

        children.append(ui.card([
            ui.text("🔍  FILTER & LIVE SEARCH", "labelSmall", color="secondary"),
            ui.row(filter_buttons[:3]),
            ui.row(filter_buttons[3:]),
            ui.text_field(value=self._filter_query,
                          on_change=self._value(self._set_query, refresh=True),
                          label="Search IP, Port, Domain (e.g. google, 443, 10.187)"),
        ]))

        # 3. Linux Terminal Output Stream Box
        visible_pkts = []
        with self._lock:
            all_items = list(self._packets)

        for idx, pkt in enumerate(all_items):
            if self._filter_proto == "HOTSPOT" and not pkt["is_hotspot"]:
                continue
            if self._filter_proto not in ("ALL", "HOTSPOT") and pkt["proto"] != self._filter_proto:
                continue
            if self._filter_query:
                q = self._filter_query.strip().lower()
                blob = "{} {} {} {}".format(pkt["src"], pkt["dst"], pkt["proto"], pkt["info"]).lower()
                if q not in blob:
                    continue
            visible_pkts.append((idx, pkt))

        if not visible_pkts:
            children.append(ui.card([
                ui.row([
                    ui.text("📡  WAITING FOR LIVE TRAFFIC", "titleSmall", color="primary"),
                    ui.text("100% Genuine Wire", "labelSmall", color="secondary"),
                ]),
                ui.text("Terminal buffer is empty. No packets captured yet on [{}].".format(self._iface), "bodyMedium"),
                ui.text("To test: Connect your laptop to your phone's hotspot. Once connected, open a website or run 'ping 1.1.1.1' on your laptop — real packets will stream here immediately.", "bodySmall", color="muted"),
                ui.row([
                    self._button(ui, "🔄 Scan Connected Clients", self._poll_system_clients, style="tonal"),
                    self._button(ui, "▶ Start Capture", self._start_capture, enabled=not self._capturing, style="filled"),
                ])
            ]))
        else:
            # Format terminal lines like Linux tshark / tcpdump
            display_slice = visible_pkts[-50:] if self._auto_scroll else visible_pkts[:50]
            terminal_lines = [self._format_terminal_line(p, i + 1) for i, p in display_slice]
            terminal_block = "\n".join(terminal_lines)

            children.append(ui.card([
                ui.row([
                    ui.text("🖥️  LINUX TERMINAL FEED", "labelSmall", color="secondary"),
                    ui.text("{} pkts matched".format(len(visible_pkts)), "labelSmall", color="primary"),
                ]),
                ui.log_panel(terminal_block, max_height=320),
                ui.row([
                    self._button(ui, "📋 Switch to Card View", lambda: self._go("packets"), style="outlined"),
                    self._button(ui, "💾 Export .pcap", lambda: self._export_pcap(), style="tonal"),
                ]),
            ]))

        children.append(self._bottom_nav(ui))
        return children

    def _set_filter(self, proto):
        self._filter_proto = proto
        self._refresh(force=True)

    # ═══════════ SCREEN 2: PACKETS TABLE VIEW ═══════════

    def _packets_table_ui(self, ui):
        children = [
            ui.row([
                ui.text("📋  PACKET LIST", "titleMedium"),
                self._button(ui, "🖥️ To Terminal", lambda: self._go("live"), style="filled"),
            ])
        ]

        visible_pkts = []
        with self._lock:
            all_items = list(self._packets)

        for idx, pkt in enumerate(all_items):
            if self._filter_proto == "HOTSPOT" and not pkt["is_hotspot"]:
                continue
            if self._filter_proto not in ("ALL", "HOTSPOT") and pkt["proto"] != self._filter_proto:
                continue
            if self._filter_query:
                q = self._filter_query.strip().lower()
                blob = "{} {} {} {}".format(pkt["src"], pkt["dst"], pkt["proto"], pkt["info"]).lower()
                if q not in blob:
                    continue
            visible_pkts.append((idx, pkt))

        if not visible_pkts:
            children.append(ui.card([ui.text("No matching packets", "bodyMedium", color="secondary")]))
        else:
            display_slice = visible_pkts[-40:]
            display_slice.reverse()

            children.append(ui.text("Showing latest {} packets".format(len(display_slice)), "labelSmall", color="muted"))

            for idx, pkt in display_slice:
                src_dst = "{} → {}".format(pkt["src"] or "Local", pkt["dst"] or "Broadcast")
                hotspot_tag = " [LAPTOP]" if pkt["is_hotspot"] else ""
                proto_color = "primary" if pkt["proto"] in ("DNS", "TLS", "HTTP") else "secondary"

                card_items = [
                    ui.row([
                        ui.text("#{:<4} {}".format(idx + 1, pkt["proto"]), "titleSmall", color=proto_color),
                        ui.text("{:.3f}s".format(pkt["time"] % 100), "labelSmall", color="muted"),
                    ]),
                    ui.text(src_dst + hotspot_tag, "bodyMedium", color="primary" if pkt["is_hotspot"] else "secondary"),
                    ui.text(pkt["info"][:80], "labelSmall", color="muted"),
                    self._button(ui, "🔍 Inspect Detail", lambda i=idx: self._open_detail(i), style="text"),
                ]
                children.append(ui.card(card_items))

        children.append(self._bottom_nav(ui))
        return children

    def _open_detail(self, idx):
        self._selected_pkt_idx = idx
        self._page = "detail"
        self._refresh(force=True)

    # ═══════════ SCREEN 3: WIRESHARK 3-PANE DETAIL ═══════════

    def _detail_ui(self, ui):
        children = [
            ui.button("← Back to Live Console", self._bind(self._go, "live"), style="filled")
        ]

        if self._selected_pkt_idx is None or self._selected_pkt_idx >= len(self._packets):
            children.append(ui.card([
                ui.text("No packet selected", "titleMedium"),
                ui.text("Tap on any packet in the table to inspect headers and raw hex.", "bodySmall", color="secondary"),
            ]))
            children.append(self._bottom_nav(ui))
            return children

        with self._lock:
            pkt = list(self._packets)[self._selected_pkt_idx]

        raw = pkt["raw"]
        hex_dump = self._generate_hex_dump(raw)

        # 1. Packet Summary Card
        children.append(ui.card([
            ui.text("PACKET #{}: {}".format(self._selected_pkt_idx + 1, pkt["proto"]), "titleMedium", color="primary"),
            ui.text("Length: {} bytes · Epoch: {:.6f}".format(len(raw), pkt["time"]), "bodySmall", color="secondary"),
            ui.text(pkt["info"], "bodyMedium"),
        ]))

        # 2. Protocol Tree (Wireshark Middle Pane)
        tree_cards = []

        # Layer 2: Ethernet
        if pkt.get("eth"):
            eth = pkt["eth"]
            tree_cards.append(ui.card([
                ui.text("▼ Layer 2: Ethernet II", "titleSmall", color="primary"),
                ui.text("Source MAC: {}".format(eth.get("src", "N/A")), "bodySmall"),
                ui.text("Destination MAC: {}".format(eth.get("dst", "N/A")), "bodySmall"),
                ui.text("EtherType: {}".format(eth.get("type", "N/A")), "bodySmall", color="muted"),
            ]))

        # Layer 3: IP
        if pkt.get("ip"):
            ip = pkt["ip"]
            tree_cards.append(ui.card([
                ui.text("▼ Layer 3: Internet Protocol Version {}".format(ip["version"]), "titleSmall", color="primary"),
                ui.text("Source IP: {}".format(ip["src"]), "bodySmall"),
                ui.text("Destination IP: {}".format(ip["dst"]), "bodySmall"),
                ui.text("Protocol: {} · TTL: {}".format(ip["proto"], ip["ttl"]), "bodySmall"),
                ui.text("Header Len: {} bytes · Total: {} bytes".format(ip["ihl"], ip["total_len"]), "labelSmall", color="muted"),
            ]))

        # Layer 4: TCP / UDP / ICMP / ARP
        if pkt.get("l4"):
            l4 = pkt["l4"]
            t = l4["type"]
            if t == "TCP":
                tree_cards.append(ui.card([
                    ui.text("▼ Layer 4: Transmission Control Protocol (TCP)", "titleSmall", color="primary"),
                    ui.text("Source Port: {} · Destination Port: {}".format(l4["sport"], l4["dport"]), "bodySmall"),
                    ui.text("Flags: {} · Window: {}".format(l4["flags"], l4["win"]), "bodySmall"),
                    ui.text("Seq: {} · Ack: {}".format(l4["seq"], l4["ack"]), "labelSmall", color="muted"),
                ]))
            elif t == "UDP":
                tree_cards.append(ui.card([
                    ui.text("▼ Layer 4: User Datagram Protocol (UDP)", "titleSmall", color="primary"),
                    ui.text("Source Port: {} · Destination Port: {}".format(l4["sport"], l4["dport"]), "bodySmall"),
                    ui.text("Length: {} bytes".format(l4["len"]), "labelSmall", color="muted"),
                ]))
            elif t == "ICMP":
                tree_cards.append(ui.card([
                    ui.text("▼ Layer 4: Internet Control Message Protocol (ICMP)", "titleSmall", color="primary"),
                    ui.text("Type: {} ({})".format(l4["itype"], l4["desc"]), "bodySmall"),
                    ui.text("Code: {}".format(l4["icode"]), "labelSmall", color="muted"),
                ]))

        # Layer 7: Application (DNS / TLS / HTTP)
        if pkt.get("app"):
            app = pkt["app"]
            if pkt["proto"] == "DNS":
                tree_cards.append(ui.card([
                    ui.text("▼ Layer 7: Domain Name System (DNS)", "titleSmall", color="primary"),
                    ui.text("Domain: {}".format(app["qname"]), "bodyMedium"),
                    ui.text("Record: {} · Transaction ID: 0x{:04x}".format(app["qtype"], app["id"]), "bodySmall"),
                    ui.text("Direction: {}".format("Response" if app["is_response"] else "Query"), "labelSmall", color="muted"),
                ]))
            elif pkt["proto"] == "TLS":
                tree_cards.append(ui.card([
                    ui.text("▼ Layer 7: Transport Layer Security (TLS)", "titleSmall", color="primary"),
                    ui.text("SNI Hostname: {}".format(app.get("sni", "")), "bodyMedium", color="primary"),
                    ui.text("Handshake: Client Hello (Target server decoded from encrypted session)", "bodySmall", color="secondary"),
                ]))
            elif pkt["proto"] == "HTTP":
                tree_cards.append(ui.card([
                    ui.text("▼ Layer 7: Hypertext Transfer Protocol (HTTP)", "titleSmall", color="primary"),
                    ui.text("Request: {}".format(app.get("first_line", "")), "bodySmall"),
                    ui.text("Host: {}".format(app.get("host", "N/A")), "bodySmall"),
                    ui.text("User-Agent: {}".format(app.get("user_agent", "N/A")), "labelSmall", color="muted"),
                ]))

        children.extend(tree_cards)

        # 3. Hex & ASCII Dump (Wireshark Bottom Pane)
        children.append(ui.card([
            ui.text("RAW HEX & ASCII DUMP (WIRESHARK LOWER PANE)", "labelSmall", color="secondary"),
            ui.log_panel(hex_dump, max_height=260),
        ]))

        children.append(self._bottom_nav(ui))
        return children

    # ═══════════ SCREEN 4: HOTSPOT & NETWORK ANALYTICS ═══════════

    def _stats_ui(self, ui):
        children = [
            ui.card([
                ui.text("📊  HOTSPOT & NETWORK INTELLIGENCE", "labelSmall", color="secondary"),
                ui.text("Real-time profile of connected laptop and network flows", "bodySmall", color="secondary"),
            ])
        ]

        # 1. Hotspot Connected Laptop Dossier
        client_cards = [ui.text("💻  CONNECTED CLIENTS (HOTSPOT)", "titleSmall", color="primary")]
        if not self._client_traffic:
            client_cards.append(ui.text("No client devices detected yet on hotspot subnet.", "bodySmall", color="muted"))
        else:
            for ip, stats in self._client_traffic.items():
                domains_str = ", ".join(list(stats["domains"])[:5]) if stats["domains"] else "None yet"
                client_cards.append(ui.card([
                    ui.text("Client: " + ip, "titleSmall", color="primary"),
                    ui.row([
                        ui.text("Packets: {:,}".format(stats["pkts"]), "bodySmall"),
                        ui.text("Data: {:.1f} KB".format(stats["bytes"] / 1024), "bodySmall"),
                    ]),
                    ui.text("Domains Visited: " + domains_str, "labelSmall", color="muted"),
                    self._button(ui, "Filter Traffic from " + ip, lambda p=ip: self._filter_client(p), style="outlined"),
                ]))
        children.append(ui.card(client_cards))

        # 2. Hotspot Domains Visited
        domain_items = [ui.text("🌐  ALL DOMAINS VISITED (DNS & TLS SNI)", "titleSmall", color="primary")]
        if not self._hotspot_domains:
            domain_items.append(ui.text("No domain lookups recorded yet.", "bodySmall", color="muted"))
        else:
            for domain, count in self._hotspot_domains.most_common(12):
                domain_items.append(ui.row([
                    ui.text(domain, "bodyMedium"),
                    ui.text("{} reqs".format(count), "labelSmall", color="secondary"),
                ]))
        children.append(ui.card(domain_items))

        # 3. Protocol Distribution
        proto_items = [ui.text("📦  PROTOCOL BREAKDOWN", "titleSmall", color="primary")]
        if not self._proto_counts:
            proto_items.append(ui.text("No packets captured.", "bodySmall", color="muted"))
        else:
            total = max(1, sum(self._proto_counts.values()))
            for proto, count in self._proto_counts.most_common(8):
                pct = (count / total) * 100.0
                proto_items.append(ui.row([
                    ui.text(proto, "bodyMedium"),
                    ui.text("{} ({:.1f}%)".format(count, pct), "labelSmall", color="secondary"),
                ]))
        children.append(ui.card(proto_items))

        # 4. Top Talkers
        talker_items = [ui.text("📡  TOP TALKERS (BANDWIDTH USAGE)", "titleSmall", color="primary")]
        if not self._top_talkers:
            talker_items.append(ui.text("No traffic recorded.", "bodySmall", color="muted"))
        else:
            for ip, bcount in self._top_talkers.most_common(8):
                is_laptop = " (Laptop)" if ip in self._hotspot_clients else ""
                talker_items.append(ui.row([
                    ui.text((ip or "Unknown") + is_laptop, "bodyMedium"),
                    ui.text("{:.1f} KB".format(bcount / 1024), "labelSmall", color="secondary"),
                ]))
        children.append(ui.card(talker_items))

        children.append(self._bottom_nav(ui))
        return children

    def _filter_client(self, ip):
        self._filter_query = ip
        self._page = "live"
        self._toast("Filtering traffic for: " + ip)
        self._refresh(force=True)

    # ═══════════ SCREEN 5: PCAP FILES & EXPORT ═══════════

    def _pcap_ui(self, ui):
        children = [
            ui.card([
                ui.text("📂  PCAP CAPTURE FILES", "labelSmall", color="secondary"),
                ui.text("Open or save standard .pcap captures (Wireshark compatible)", "bodySmall", color="secondary"),
                ui.row([
                    self._button(ui, "💾 Export Current PCAP", lambda: self._export_pcap(), style="filled"),
                    self._button(ui, "⚡ Sample PCAP", self._generate_synthetic_sample, style="tonal"),
                ]),
            ])
        ]

        pcap_list = []
        try:
            download_dir = "/sdcard/Download"
            if os.path.isdir(download_dir):
                for name in sorted(os.listdir(download_dir), reverse=True):
                    if name.lower().endswith(".pcap") or name.lower().endswith(".cap"):
                        pcap_list.append(os.path.join(download_dir, name))
        except Exception:
            pass

        if not pcap_list:
            children.append(ui.card([
                ui.text("📭  No .pcap files found in Download", "titleMedium"),
                ui.text("Capture live traffic and export, or copy PCAP files from PC.", "bodySmall", color="secondary"),
            ]))
        else:
            children.append(ui.text("Found {} capture files".format(len(pcap_list)), "labelSmall", color="muted"))
            for path in pcap_list[:15]:
                name = os.path.basename(path)
                sz = os.path.getsize(path) / 1024
                children.append(ui.card([
                    ui.text("📄  " + name, "titleMedium"),
                    ui.text("{:.1f} KB · {}".format(sz, path), "labelSmall", color="muted"),
                    self._button(ui, "📂 Open in Analyzer", lambda p=path: self._import_pcap(p), style="tonal"),
                ]))

        children.append(self._bottom_nav(ui))
        return children

    # ═══════════ SCREEN 6: SETTINGS & TUNING ═══════════

    def _settings_ui(self, ui):
        children = [
            ui.card([
                ui.text("⚙️  CAPTURE CONFIGURATION", "labelSmall", color="secondary"),
                ui.text("Interface: Active capture network adapter", "bodySmall", color="secondary"),
                ui.row([
                    self._button(ui, "ap0 (Hotspot)", lambda: self._set_iface("ap0"),
                                 style="filled" if self._iface == "ap0" else "outlined"),
                    self._button(ui, "any (All)", lambda: self._set_iface("any"),
                                 style="filled" if self._iface == "any" else "outlined"),
                    self._button(ui, "wlan0 (Wi-Fi)", lambda: self._set_iface("wlan0"),
                                 style="filled" if self._iface == "wlan0" else "outlined"),
                ]),
                ui.divider(),
                ui.row([
                    ui.text("Buffer: {} pkts".format(self._ring_limit), "bodyMedium"),
                    self._button(ui, "1000", lambda: self._set_limit(1000), style="text"),
                    self._button(ui, "2000", lambda: self._set_limit(2000), style="text"),
                    self._button(ui, "3000", lambda: self._set_limit(3000), style="text"),
                ]),
                ui.divider(),
                ui.row([
                    ui.text("Auto-export PCAP on stop", "bodyMedium"),
                    self._button(ui, "ON" if self._auto_save_pcap else "OFF",
                                 self._toggle_auto_save, style="tonal" if self._auto_save_pcap else "outlined"),
                ]),
            ])
        ]
        children.append(self._bottom_nav(ui))
        return children

    def _set_iface(self, iface):
        self._iface = iface
        self._save_state()
        self._toast("Interface set to: " + iface)
        self._refresh(force=True)

    def _set_limit(self, limit):
        self._ring_limit = limit
        self._packets = deque(list(self._packets)[-limit:], maxlen=limit)
        self._save_state()
        self._toast("Buffer limit: {}".format(limit))
        self._refresh(force=True)

    def _toggle_auto_save(self):
        self._auto_save_pcap = not self._auto_save_pcap
        self._save_state()
        self._refresh(force=True)

    # ═══════════ MAIN RENDER DISPATCHER ═══════════

    def screen_main(self, ui, api=None, state=None, *args, **kwargs):
        if api is not None:
            self.api = api
        if not self._ready:
            try:
                self.on_plugin_load()
            except Exception:
                pass

        if not self._ready:
            return ui.scaffold(
                title="PacketShark",
                content=ui.column([
                    ui.text("Initializing PacketShark…", "titleMedium"),
                    ui.circular_progress(),
                ], padding=16, spacing=10, fill_max_size=True)
            )

        try:
            if self._page == "live":
                page_body = self._live_console_ui(ui)
            elif self._page == "packets":
                page_body = self._packets_table_ui(ui)
            elif self._page == "detail":
                page_body = self._detail_ui(ui)
            elif self._page == "stats":
                page_body = self._stats_ui(ui)
            elif self._page == "pcap":
                page_body = self._pcap_ui(ui)
            elif self._page == "settings":
                page_body = self._settings_ui(ui)
            else:
                page_body = self._live_console_ui(ui)
        except Exception as exc:
            self._log("error", "render page: " + str(exc))
            page_body = [
                ui.card([
                    ui.text("Render Error", "titleMedium", color="error"),
                    ui.text(str(exc)[:200], "bodySmall"),
                    self._button(ui, "Back to Live Feed", lambda: self._go("live"), style="tonal")
                ])
            ]

        body = []
        # Top-Stacked Connected Device Nameplates
        body.extend(self._render_nameplates(ui))
        # Current Tab Body Content
        body.extend(page_body)

        content = ui.lazy_column(body, padding=16, spacing=10, fill_max_size=True)

        page_titles = {
            "live": "PacketShark · Live Stream",
            "packets": "PacketShark · Packets",
            "detail": "PacketShark · Packet Details",
            "stats": "PacketShark · Analytics",
            "pcap": "PacketShark · PCAP Files",
            "settings": "PacketShark · Settings",
        }
        title = page_titles.get(self._page, "PacketShark")

        actions = []
        try:
            if self._capturing:
                actions.append(ui.top_action("stop", self._stop_capture))
            else:
                actions.append(ui.top_action("play_arrow", self._start_capture))
            actions.append(ui.top_action("refresh", lambda: self._refresh(force=True)))
        except Exception:
            actions = None

        return ui.scaffold(
            title=title,
            actions=actions,
            content=content
        )
