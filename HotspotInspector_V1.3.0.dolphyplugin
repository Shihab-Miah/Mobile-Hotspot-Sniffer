# -*- coding: utf-8 -*-
"""
Dolphy App Plugin: Hotspot Network Inspector & Silent Device Identifier
Compatible with Dolphy 2.5+ (Chaquopy Python 3.11 Runtime)
Version 1.3.0 - Features Persistent Late-Launch Discovery & Clean Human-Readable Telemetry
"""

__id__ = "hotspot_inspector"
__name__ = "Hotspot Inspector"
__title__ = "Hotspot Inspector"
__icon__ = "rounded:router"
__version__ = "1.3.0"
__author__ = "Lab"
__description__ = "Silent hotspot client discovery, organized device nameplates, and human-readable telemetry."
__permissions__ = ["files", "shizuku"]

import os
import re
import sys
import time
import json
import socket
import select
import hashlib
import threading
import http.server
import socketserver
from datetime import datetime

# Dolphy BasePlugin injection fallback
if "BasePlugin" not in globals() and "BasePlugin" not in dir(__builtins__):
    try:
        from dolphy import BasePlugin
    except Exception:
        try:
            from dolphy.plugin import BasePlugin
        except Exception:
            class BasePlugin:
                def __init__(self, *args, **kwargs):
                    self.modules = []
                def add_module(self, *args, **kwargs):
                    pass
                def toast(self, msg): pass
                def log(self, level, msg): pass
                def refresh(self): pass
                def root(self, cmd): return ""
                def shizuku(self, cmd): return ""


# =============================================================================
# Fallback HTTP Gateway Handler (Direct Browser Verification)
# =============================================================================

class _GatewayHTTPHandler(http.server.BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        pass

    def do_GET(self):
        client_ip = self.client_address[0]
        user_agent = self.headers.get("User-Agent", "Unknown Device")
        host_header = self.headers.get("Host", "")

        if hasattr(self.server, "plugin_instance"):
            self.server.plugin_instance.register_http_handshake(client_ip, user_agent, host_header)

        body = f"""<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Hotspot Inspector - Registered</title>
    <style>
        body {{
            background: #0f141c; color: #e2e8f0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            margin: 0; padding: 30px 16px; display: flex; justify-content: center;
        }}
        .box {{
            background: #1a2230; border: 1px solid #2d3748; border-radius: 16px;
            padding: 24px; max-width: 440px; width: 100%; box-shadow: 0 10px 25px rgba(0,0,0,0.5);
            text-align: center;
        }}
        .badge {{
            display: inline-block; background: #10b981; color: #ffffff;
            padding: 6px 14px; border-radius: 9999px; font-size: 13px; font-weight: 700;
            margin-bottom: 16px;
        }}
        h2 {{ margin: 0 0 10px; font-size: 22px; color: #ffffff; }}
        p {{ margin: 6px 0; color: #94a3b8; font-size: 14px; }}
        .data-grid {{
            margin-top: 20px; text-align: left; background: #111827;
            padding: 14px; border-radius: 10px; border: 1px solid #1f2937;
        }}
        .data-row {{ display: flex; justify-content: space-between; margin: 6px 0; font-size: 13px; }}
        .label {{ color: #64748b; font-weight: 600; }}
        .value {{ color: #38bdf8; font-family: monospace; font-weight: bold; }}
    </style>
</head>
<body>
    <div class="box">
        <span class="badge">&#10003; DEVICE VERIFIED</span>
        <h2>Hotspot Inspector</h2>
        <p>Your device identity is now pinned on the Hotspot Inspector dashboard.</p>
        <div class="data-grid">
            <div class="data-row"><span class="label">Client IP:</span><span class="value">{client_ip}</span></div>
            <div class="data-row"><span class="label">Gateway:</span><span class="value">{self.server.gateway_ip}:8080</span></div>
            <div class="data-row"><span class="label">Timestamp:</span><span class="value">{datetime.now().strftime("%H:%M:%S")}</span></div>
        </div>
    </div>
</body>
</html>"""
        encoded = body.encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(encoded)))
        self.send_header("Connection", "close")
        self.end_headers()
        self.wfile.write(encoded)


class _ThreadedTCPServer(socketserver.ThreadingMixIn, socketserver.TCPServer):
    allow_reuse_address = True
    daemon_threads = True


# =============================================================================
# Main Hotspot Inspector Plugin
# =============================================================================

